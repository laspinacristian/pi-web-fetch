{
  "name": "pi-web-fetch",
  "version": "1.0.0",
  "description": "Pi coding agent extension: a web_fetch tool that reads any URL as compact markdown — web pages, docs, PDFs, images, YouTube transcripts, GitHub issues and PRs, Stack Overflow.",
  "type": "module",
  "license": "MIT",
  "author": "Cristian La Spina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laspinacristian/pi-web-fetch.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "web-fetch",
    "markdown",
    "defuddle"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc -p .",
    "test": "node --test test/"
  },
  "dependencies": {
    "defuddle": "^0.19.4",
    "linkedom": "^0.18.13",
    "unpdf": "^1.8.1",
    "wreq-js": "^3.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.35",
    "typescript": "^7.0.2"
  }
}
